tgl-trace 1
# Plan §3.4 example: A=0 B=1 C=2 D=3 E=4. Expected values worked out by hand.
nodes 5
edge 0 2 2    # e0  A->C
edge 2 4 3    # e1  C->E
edge 1 3 7    # e2  B->D
edge 3 4 1    # e3  D->E
period 10

expect at 4 8            # B->D->E dominates (8 > 5)
expect slack 1 2
check

set 0 9                  # A->C 2 -> 9: A->C->E = 12 becomes critical
update
expect at 4 12
expect slack 0 -2
expect changed 3         # AT(C), AT(E), RT(A)
check

set 1 4                  # C->E 3 -> 4
update conservative
expect at 4 13
check

reset
expect at 4 8
check

set 2 1                  # the same edge twice before one update: the last value wins
set 2 20
update
expect at 4 21
expect rt 1 -11          # RT(B) = 10 - 1 - 20
check

set 2 20                 # setting the current value is a no-op
update
expect changed 0

update                   # nothing pending
expect changed 0
check

set 3 0                  # zero delay is a value, not "unset"
update
expect at 4 20
check
